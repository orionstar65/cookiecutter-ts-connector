{
  "name": "@ucp/express",
  "type": "module",
  "version": "1.12.4",
  "author": "orionstar65",
  "license": "MIT",
  "description": "Express utilities for UCP connectors: middleware, healthchecks, auth, etc.",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./*.js": "./dist/*.js",
    "./*": "./dist/*.js"
  },
  "bin": {
    "ucp-loghash": "./bin/ucp-loghash.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orionstar65/cookiecutter-typescript-connector.git"
  },
  "keywords": [
    "typescript",
    "package"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "cors": "^2.8.6",
    "errorhandler": "^1.5.2",
    "express": "^5.2.1",
    "express-list-routes": "^1.3.2",
    "http-errors": "^2.0.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "undici": "^7.25.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6",
    "@ucp/api-schema-connect": "file:../ucp-api-schema-connect"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.61.2",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5",
    "@ucp/express": "file:src"
  },
  "scripts": {
    "prepack": "mkdir -p build && npm run build",
    "pretest": "npm run check && npm run lint",
    "preversion": "git diff --quiet && npm run test",
    "check": "tsc --noEmit",
    "clean": "git clean -fdqx -e .env*",
    "build": "tsc --build",
    "format": "npm run format:src && npm run format:docs",
    "format:src": "prettier --write src && eslint src --fix",
    "format:docs": "prettier --write **/*.md",
    "get:name": "npm pkg get name --workspaces=false | tr -d \\\"",
    "get:home": "npm pkg get homepage --workspaces=false | tr -d \\\"",
    "get:version": "npm pkg get version --workspaces=false | tr -d \\\"",
    "lint": "eslint src && prettier --check src",
    "replay": "echo \"replay disabled in vendored package\"",
    "shell": "tsx",
    "tag:current": "version=$(npm run get:version --silent) && echo \"v${version}\"",
    "tag:latest": "git describe --tags $(git rev-list --tags --max-count=1)",
    "test": "vitest run --coverage",
    "update": "ncu -u && npm install && npm audit fix",
    "postbuild": "tsc-alias",
    "postpack": "mv *.tgz build"
  }
}

{
  "name": "@{{ cookiecutter.username }}/{{ cookiecutter.slug }}",
  "type": "module",
  "version": "{{ cookiecutter.version }}",
  "license": "Apache-2.0",
  "author": "{{ cookiecutter.author }}",
  "description": "{{ cookiecutter.description }}",
  "homepage": "https://github.com/{{ cookiecutter.username }}/{{ cookiecutter.slug }}#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/{{ cookiecutter.username }}/{{ cookiecutter.slug }}.git"
  },
  "bugs": {
    "url": "https://github.com/{{ cookiecutter.username }}/{{ cookiecutter.slug }}/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "typescript",
    "api",
    "express"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@ucp/api-schema-connect": "file:packages/ucp-api-schema-connect",
    "@ucp/express": "file:packages/ucp-express",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-list-routes": "^1.3.2",
    "http-status-codes": "^2.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@{{ cookiecutter.username }}/{{ cookiecutter.slug }}": "file:src",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsforce": "^1.11.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "shx": "^0.4.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "scripts": {
    "predocker": "npm run docker:build",
    "preformat": "git diff --quiet",
    "prepack": "npm run clean && npm install && npm run build",
    "pretest": "npm run lint",
    "preversion": "npm run test",
    "clean": "shx rm -rf ./dist ./.logs ./node_modules",
    "build": "tsc --build",
    "docker": "docker compose up",
    "docker:build": "docker compose build",
    "format": "prettier --write src",
    "get:name": "npm pkg get name --workspaces=false | tr -d \\\"",
    "get:semver": "npm pkg get version --workspaces=false | tr -d \\\"",
    "get:semver:tag": "version=$(npm run version --silent) && echo \"v${version}\"",
    "get:semver:latest": "git describe --tags $(git rev-list --tags --max-count=1)",
    "get:home": "npm pkg get homepage --workspaces=false | tr -d \\\"",
    "lint": "eslint && prettier --check src",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" NODE_ENV=\"local\" jest --detectOpenHandles --runInBand",
    "postbuild": "tsc-alias",
    "postformat": "git commit -am \"'npm run format'\""
  }
}
